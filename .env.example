# CraftAI Environment Configuration
# Copy this to .env and fill in values

# ===== Encryption (REQUIRED) =====
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=
URL_SIGNING_SECRET=
REQUEST_SIGNING_SECRET=
APP_SECRET=

# ===== MiniMax API =====
# Your MiniMax API key (will be encrypted for production)
MINIMAX_API_KEY=
# Optional: encrypted version of the key (for production)
ENCRYPTED_MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com

# ===== PayPal =====
# ── PayPal（见 docs/paypal-setup.md）──
# 沙箱凭据：Dashboard ▸ Apps & Credentials ▸ Sandbox ▸ Default Application
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# true = 沙箱（默认），false = 正式环境
PAYPAL_SANDBOX=true
# 订阅计划 id（$9.99/月）；一次性支付不需要，用金额直接下单
PAYPAL_CREATOR_PLAN_ID=
PAYPAL_PRO_PLAN_ID=
# Webhook id（Dashboard ▸ 应用 ▸ Webhooks），生产必须配，否则跳过签名验证
PAYPAL_WEBHOOK_ID=

# ===== OAuth (Optional) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===== App Config =====
NUXT_PUBLIC_APP_NAME=CraftAI
NUXT_PUBLIC_APP_URL=https://craftai.ai

# ===== Analytics (可选) =====
# Plausible Analytics 域名 (如: creator.yozzytools.com)
PLAUSIBLE_DOMAIN=
