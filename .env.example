# CraftAI Environment Configuration
# Copy this to .env and fill in values

# ===== Encryption (REQUIRED) =====
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=
URL_SIGNING_SECRET=
REQUEST_SIGNING_SECRET=
APP_SECRET=

# ===== MiniMax API =====
# Your MiniMax API key (will be encrypted for production)
MINIMAX_API_KEY=
# Optional: encrypted version of the key (for production)
ENCRYPTED_MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com

# ===== PayPal =====
# ── PayPal（见 docs/paypal-setup.md）──
# 沙箱凭据：Dashboard ▸ Apps & Credentials ▸ Sandbox ▸ Default Application
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# true = 沙箱（默认），false = 正式环境
PAYPAL_SANDBOX=true
# 订阅计划 id（$19.99/月）；一次性支付不需要 Plan，用金额直接下单
# ⚠️ 订阅实收金额由 PayPal 后台这个 plan 对象决定，代码里的 price 只是显示用
#    改价后必须同步后台，否则前端显示价 ≠ 实收价（少收钱 + 虚假宣传）
PAYPAL_CREATOR_PLAN_ID=
PAYPAL_PRO_PLAN_ID=
# Webhook id（Dashboard ▸ 应用 ▸ Webhooks）
# ⚠️ 生产必须配：不配时服务端会拒绝验签，webhook 全部失败（不会降级成"不验签"）
PAYPAL_WEBHOOK_ID=

# ===== OAuth (Optional) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===== App Config =====
NUXT_PUBLIC_APP_NAME=Create Keepsakes
# ⚠️ 变量名是 NUXT_PUBLIC_SITE_URL（不是 APP_URL），全站 canonical/og/sitemap 都读它
NUXT_PUBLIC_SITE_URL=https://create.yozzytools.com
# PayPal 的 return_url / cancel_url 前缀；不设会退化成当前请求域名
# （走 pages.dev 默认域名访问时，用户批准后会回跳到 pages.dev 而不是品牌域名）
PUBLIC_SITE_URL=https://create.yozzytools.com

# ===== Analytics (可选) =====
# Plausible Analytics 域名 (如: creator.yozzytools.com)
PLAUSIBLE_DOMAIN=
